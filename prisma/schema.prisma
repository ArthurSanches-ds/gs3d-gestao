generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Acesso ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// ---------- Parâmetros ----------

model Settings {
  id                   Int      @id @default(1)
  printerPrice         Decimal  @db.Decimal(10, 2)
  printerLifetimeHours Int
  powerKw              Decimal  @db.Decimal(6, 3)
  energyTariff         Decimal  @db.Decimal(8, 4)
  laborHourlyRate      Decimal  @db.Decimal(10, 2)
  defaultLaborMinutes  Int
  failureReserve       Decimal  @db.Decimal(5, 4)
  margin               Decimal  @db.Decimal(6, 4)
  tax                  Decimal  @db.Decimal(5, 4)
  rentRate             Decimal  @db.Decimal(5, 4)
  lowFilamentGrams     Int
  salaryGoal           Decimal  @db.Decimal(10, 2)
  updatedAt            DateTime @updatedAt
}

model SalesChannel {
  id     String           @id @default(cuid())
  name   String           @unique
  active Boolean          @default(true)
  tiers  ChannelFeeTier[]
  sales  Sale[]
}

model ChannelFeeTier {
  id         String       @id @default(cuid())
  channelId  String
  channel    SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  minPrice   Decimal      @db.Decimal(10, 2)
  maxPrice   Decimal?     @db.Decimal(10, 2)
  commission Decimal      @db.Decimal(5, 4)
  fixedFee   Decimal      @db.Decimal(10, 2)
}

model PaymentMethod {
  id           String  @id @default(cuid())
  name         String  @unique
  feeRate      Decimal @db.Decimal(5, 4)
  installments Int     @default(1)
  sortOrder    Int     @default(0)
  sales        Sale[]
}

model ProfitBucket {
  id        String  @id @default(cuid())
  key       String  @unique
  name      String
  rate      Decimal @db.Decimal(5, 4)
  sortOrder Int     @default(0)
}

model FixedExpense {
  id            String  @id @default(cuid())
  name          String
  monthlyAmount Decimal @db.Decimal(10, 2)
  active        Boolean @default(true)
}

// ---------- Estoque de filamentos ----------

enum FilamentMovementType {
  WEIGH_IN    // pesagem: grams = peso líquido real (substitui o saldo)
  PURCHASE    // compra: grams positivo
  CONSUMPTION // consumo: grams negativo
  ADJUSTMENT  // ajuste manual: positivo ou negativo
}

model Filament {
  id             String             @id @default(cuid())
  color          String
  brand          String
  material       String             @default("PLA")
  rollPrice      Decimal            @db.Decimal(10, 2)
  rollNetGrams   Int                @default(1000)
  spoolTareGrams Decimal            @default(200) @db.Decimal(7, 1)
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  movements      FilamentMovement[]
  products       ProductFilament[]

  @@unique([color, brand, material])
}

model FilamentMovement {
  id              String               @id @default(cuid())
  filamentId      String
  filament        Filament             @relation(fields: [filamentId], references: [id])
  type            FilamentMovementType
  grams           Decimal              @db.Decimal(8, 1)
  occurredAt      DateTime             @default(now())
  note            String?
  productionRunId String?
  productionRun   ProductionRun?       @relation(fields: [productionRunId], references: [id])
  createdAt       DateTime             @default(now())

  @@index([filamentId, occurredAt])
}

// ---------- Insumos ----------

enum SupplyMovementType {
  PURCHASE   // compra: quantity positivo
  USE        // uso em venda: quantity negativo
  ADJUSTMENT // ajuste manual
}

model Supply {
  id           String           @id @default(cuid())
  name         String           @unique
  packPrice    Decimal          @db.Decimal(10, 2)
  packQuantity Int
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  movements    SupplyMovement[]
  products     ProductSupply[]
}

model SupplyMovement {
  id         String             @id @default(cuid())
  supplyId   String
  supply     Supply             @relation(fields: [supplyId], references: [id])
  type       SupplyMovementType
  quantity   Decimal            @db.Decimal(8, 2)
  occurredAt DateTime           @default(now())
  note       String?
  saleItemId String?
  saleItem   SaleItem?          @relation(fields: [saleItemId], references: [id])
  createdAt  DateTime           @default(now())

  @@index([supplyId, occurredAt])
}

// ---------- Produtos (ficha técnica) ----------

model Product {
  id             String            @id @default(cuid())
  name           String
  piecesPerPlate Int
  plateMinutes   Int
  laborMinutes   Int? // vazio = usa o padrão dos Parâmetros
  isCustom       Boolean           @default(false)
  archived       Boolean           @default(false)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  filaments      ProductFilament[]
  supplies       ProductSupply[]
  productionRuns ProductionRun[]
  movements      ProductMovement[]
  saleItems      SaleItem[]
}

model ProductFilament {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  filamentId    String
  filament      Filament @relation(fields: [filamentId], references: [id])
  gramsPerPlate Decimal  @db.Decimal(8, 1)

  @@unique([productId, filamentId])
}

model ProductSupply {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplyId         String
  supply           Supply  @relation(fields: [supplyId], references: [id])
  quantityPerPiece Decimal @db.Decimal(6, 2)

  @@unique([productId, supplyId])
}

// ---------- Produção e estoque de produto pronto ----------

model ProductionRun {
  id                String             @id @default(cuid())
  productId         String? // vazio = lote avulso (teste, peça sem cadastro)
  product           Product?           @relation(fields: [productId], references: [id])
  description       String?
  plates            Int
  goodPieces        Int                @default(0)
  occurredAt        DateTime           @default(now())
  note              String?
  createdAt         DateTime           @default(now())
  filamentMovements FilamentMovement[]
  productMovements  ProductMovement[]
}

enum ProductMovementType {
  PRODUCTION // entrada: peças boas de uma produção
  SALE       // saída: venda
  ADJUSTMENT // ajuste manual
  LOSS       // perda: quebrou, deu de brinde, defeito
}

model ProductMovement {
  id              String              @id @default(cuid())
  productId       String
  product         Product             @relation(fields: [productId], references: [id])
  type            ProductMovementType
  quantity        Int
  occurredAt      DateTime            @default(now())
  note            String?
  productionRunId String?
  productionRun   ProductionRun?      @relation(fields: [productionRunId], references: [id])
  saleItemId      String?
  saleItem        SaleItem?           @relation(fields: [saleItemId], references: [id])
  createdAt       DateTime            @default(now())

  @@index([productId, occurredAt])
}

// ---------- Vendas ----------

model Sale {
  id                String         @id @default(cuid())
  occurredAt        DateTime       @default(now())
  customerName      String?
  channelId         String
  channel           SalesChannel   @relation(fields: [channelId], references: [id])
  paymentMethodId   String? // vazio = marketplace (taxa de pagamento já está na comissão)
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  passFeeToCustomer Boolean        @default(false)
  // Fotografia da maquininha no momento da venda
  cardFeeRate       Decimal        @default(0) @db.Decimal(5, 4)
  cardFee           Decimal        @default(0) @db.Decimal(10, 2)
  amountCharged     Decimal        @db.Decimal(10, 2) // total que o cliente pagou
  notes             String?
  createdAt         DateTime       @default(now())
  items             SaleItem[]

  @@index([occurredAt])
}

model SaleItem {
  id               String            @id @default(cuid())
  saleId           String
  sale             Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId        String
  product          Product           @relation(fields: [productId], references: [id])
  quantity         Int
  unitPrice        Decimal           @db.Decimal(10, 2)
  // Fotografia do custo e das taxas no momento da venda (por unidade)
  unitCost         Decimal           @db.Decimal(10, 4)
  unitLaborCost    Decimal           @db.Decimal(10, 4)
  unitWearCost     Decimal           @db.Decimal(10, 4)
  commissionRate   Decimal           @db.Decimal(5, 4)
  fixedFee         Decimal           @db.Decimal(10, 2)
  productMovements ProductMovement[]
  supplyMovements  SupplyMovement[]
}